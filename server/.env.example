# ==============================================================================
# Devmanus Local AI Backend Configuration
# 100% Free & Open-Source • No API Keys Required • Offline Ready
# Optimized for Apple Silicon Macs (M1/M2/M3/M4) with 8GB RAM
# ==============================================================================

# AI Provider: 'ollama' (default, free & local), 'gemini', or 'openai'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended models:
# - llama3.2:1b  (1.3GB) -> Ultra-fast 1.5s planning, 0 memory pressure on 8GB Mac [RECOMMENDED DEFAULT]
# - llama3.2:3b  (2.0GB) -> Richer reasoning for 16GB+ RAM Macs
# - devmanus-agent       -> Custom model built via ./ollama/setup-models.sh
OLLAMA_MODEL=llama3.2:1b

# Server port
PORT=3000

# Optional Cloud Providers (Leave blank if running 100% locally with Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini